[Unit]
Description=Apply Copilot backend (网申助手后端)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/copilot
# venv 里的 uvicorn，绑定 0.0.0.0:8787（仅服务器；本地开发请保持 127.0.0.1）
ExecStart=/opt/copilot/venv/bin/uvicorn --host 0.0.0.0 --port 8787 server:app
Restart=always
RestartSec=3
# ---- 云端环境变量 ----
# ⚠️ 真实令牌绝不能写进 Git！放服务器上的 /opt/copilot/.env（内容：AC_TOKEN=你的令牌）
#    本文件只作模板，部署时请确保 .env 存在且权限 600。
EnvironmentFile=/opt/copilot/.env
Environment=AC_DATA_DIR=/opt/copilot/data
Environment=AC_REQUIRE_AUTH=1
Environment=AC_APPLY_DIR=/opt/copilot/skill/scripts
Environment=AC_STATIC_DIR=/opt/copilot/static
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
